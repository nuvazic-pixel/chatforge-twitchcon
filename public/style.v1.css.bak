500;600;700&display=swap');
:root{color-scheme:dark;font-family:'Space Grotesk',system-ui,sans-serif;color:#eee9df;background:#101415}*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 30% 0,#283832,transparent 65%);min-height:100vh;padding:36px}main{max-width:1440px;margin:auto}header,footer,.heading{display:flex;align-items:center;justify-content:space-between}.brand{font-size:25px;letter-spacing:3px;font-weight:700;color:#d8ee9b}.brand span{font-size:10px;margin-left:22px;color:#a3aaa3;letter-spacing:2px}#connection{font-size:11px;letter-spacing:1px;color:#aaa}.online{color:#badd89!important}.heading{margin:48px 0 30px}.eyebrow{font-size:10px;letter-spacing:3px;color:#b8ca93}h1{font-size:48px;letter-spacing:-2px;margin:12px 0}p{color:#a9b2ac;line-height:1.6}.counter{text-align:right}.counter strong{display:block;font-size:56px;color:#deedb9}.counter span{font-size:10px;letter-spacing:3px;color:#a9b2ac}.layout{display:grid;grid-template-columns:2.4fr 1fr;gap:28px}.map{min-height:490px;position:relative;overflow:hidden;border:1px solid #526052;border-radius:4px;background:radial-gradient(ellipse at 24% 30%,#364b35,transparent 40%),radial-gradient(ellipse at 80% 75%,#414733,transparent 40%),#202f2c}.grid{position:absolute;inset:0;background-image:linear-gradient(#aaba9a0c 1px,transparent 1px),linear-gradient(90deg,#aaba9a0c 1px,transparent 1px);background-size:42px 42px}.river{position:absolute;width:90px;height:150%;left:58%;top:-25%;background:#36646966;border:1px solid #78ad9c33;transform:rotate(-29deg);border-radius:45%}.road{position:absolute;width:100%;height:4px;background:#c7b68944;top:54%;transform:rotate(-17deg)}.place{position:absolute;color:#8aa381;font-size:62px;text-shadow:0 8px 20px #000}.place small{display:block;font-size:9px;letter-spacing:2px;color:#a9b799}.forest{left:14%;top:12%}.village{left:43%;top:50%;color:#bcad7e}.tower{right:9%;top:15%}.north{position:absolute;right:24px;top:20px;font-size:14px;color:#a5b79b}.map-label{position:absolute;bottom:20px;left:24px;font-size:12px;letter-spacing:2px}.map-label span{display:block;font-size:9px;color:#93a590;margin-top:6px}aside{padding:22px;background:#1b2220;border:1px solid #38433b;border-radius:4px}h2{font-size:28px;line-height:1.2;margin:18px 0}.badge{display:inline-block;margin-top:15px;font-size:10px;letter-spacing:2px;color:#dcefa9}.stat{display:inline-block;background:#ffffff0c;border:1px solid #ffffff15;padding:4px 10px;margin:4px;font-size:12px}.timeline{border-top:1px solid #3b453b;margin-top:30px;padding-top:18px}ol{list-style:none;padding:0}li{font-size:13px;line-height:1.5;padding:0 0 15px 16px;border-left:1px solid #66835c;color:#b8c3b8}.marker{position:absolute;z-index:2;max-width:155px;animation:appear .6s ease-out}.marker b{display:block;width:42px;height:42px;text-align:center;line-height:40px;background:#d6ed9b;color:#1c2b22;border:3px solid #1b2922;border-radius:50%;box-shadow:0 0 30px #c7e19344;font-size:27px}.marker span{display:block;background:#101b18ed;padding:5px 8px;font-size:11px;margin-top:4px;border:1px solid #879c6d66}.danger b{background:#f5aa79}.event b{background:#a0ccd5}footer{margin-top:26px;color:#94a28f;font-size:11px;letter-spacing:1px}footer b{color:#d8ee9b;margin-right:14px}.transparent{background:transparent}.transparent main{padding:20px;background:#101815d9;border-radius:10px}html:has(.transparent){background:transparent}@keyframes appear{from{opacity:0;transform:translateY(15px)}to{opacity:1;transform:translateY(0)}}@media(max-width:850px){body{padding:18px}.layout{grid-template-columns:1fr}h1{font-size:34px}.brand span{display:none}.heading{margin-top:28px}.map{min-height:420px}}@media(prefers-reduced-motion:reduce){*{animation:none!important}}

